# Copy to .env.local. Only variables prefixed with VITE_ are exposed to the browser.
VITE_API_URL=http://localhost:8000/api

# Chain MetaMask should be on, and where to add it from if missing (Hardhat node defaults)
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=Hardhat Local
VITE_CHAIN_RPC_URL=http://127.0.0.1:8545

# Printed by `npm run deploy:jukecoin:local` in contracts/ (this is the address on a fresh node)
VITE_JUKECOIN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
